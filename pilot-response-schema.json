{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PilotInferenceResponse",
  "type": "object",
  "required": [
    "task_id",
    "agent_id",
    "request_id",
    "model",
    "status",
    "result",
    "error",
    "execution_timestamp"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "INVALID_REQUEST",
        "AUTH_FAILURE",
        "MODEL_UNAVAILABLE",
        "TIMEOUT",
        "INVALID_MODEL_OUTPUT",
        "RATE_LIMITED"
      ]
    },
    "result": {
      "type": ["object", "null"],
      "properties": {
        "text": { "type": "string" },
        "finish_reason": { "type": "string" },
        "parsed_json": { "type": ["object", "array", "null"] },
        "usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": { "type": "integer" },
            "completion_tokens": { "type": "integer" },
            "total_tokens": { "type": "integer" }
          }
        },
        "timing": {
          "type": "object",
          "properties": {
            "inference_ms": { "type": "number" },
            "total_ms": { "type": "number" }
          },
          "required": ["inference_ms", "total_ms"]
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {}
      },
      "required": ["code", "message"]
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUCCESS" } }
      },
      "then": {
        "properties": {
          "result": { "type": "object" },
          "error": { "type": "null" }
        },
        "required": ["result"]
      },
      "else": {
        "properties": {
          "result": { "type": "null" },
          "error": { "type": "object" }
        },
        "required": ["error"]
      }
    }
  ]
}
