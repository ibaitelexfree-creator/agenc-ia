{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PilotInferenceRequest",
  "type": "object",
  "required": [
    "task_id",
    "agent_id",
    "request_id",
    "model",
    "temperature",
    "messages",
    "output_schema_version"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-\\.]{3,64}$",
      "description": "Informational task identifier for telemetry and audit logging."
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-\\.]{3,64}$",
      "description": "Informational agent identifier. Does NOT grant authentication."
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-]{8,64}$",
      "description": "Client-generated or gateway-propagated correlation ID."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Target local LLM identifier. Must be actively loaded."
    },
    "temperature": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 2.0,
      "description": "Inference temperature."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "additionalProperties": false
      }
    },
    "output_schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version expected by the caller (e.g. 1.0.0)."
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000
    }
  },
  "additionalProperties": false
}
